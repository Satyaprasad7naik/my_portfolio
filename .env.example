# Server
NODE_ENV=development
PORT=4000
# Local Vite URL in development. Production frontend origin should be added here.
CLIENT_ORIGIN=http://localhost:5173

# Public contact information returned to the browser by /api/config
CONTACT_EMAIL=
WHATSAPP_PHONE=
FACEBOOK_URL=
INSTAGRAM_URL=
LINKEDIN_URL=
GITHUB_URL=

# Gmail SMTP via Google App Password (never put this in client/.env or frontend code)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Form messages are delivered here; can be same as GMAIL_USER
CONTACT_INBOX=

# Optional: WhatsApp Cloud API notification to your business number.
# Click-to-chat works with WHATSAPP_PHONE even if the Cloud API is not configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
# Use a currently supported Graph API version for your Meta app.
WHATSAPP_API_VERSION=v26.0
